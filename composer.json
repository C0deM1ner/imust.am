{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "intervention/image-laravel": "^1.5",
        "laravel/framework": "^13.17",
        "laravel/nova": "^5.0",
        "laravel/tinker": "^3.0",
        "mostafaznv/nova-ckeditor": "^7.9",
        "niels-numbers/laravel-localizer": "^1.4",
        "oneduo/nova-file-manager": "dev-main",
        "outl1ne/nova-color-field": "^3.0",
        "outl1ne/nova-multiselect-field": "^5.1",
        "outl1ne/nova-settings": "^6.0",
        "outl1ne/nova-sortable": "^4.0",
        "outl1ne/nova-translatable": "^3.1",
        "spatie/laravel-sitemap": "^8.2",
        "spatie/laravel-sluggable": "^4.0",
        "spatie/schema-org": "^5.0",
        "statikbe/laravel-nova-chained-translation-manager": "dev-nova-5-support",
        "symfony/dependency-injection": "^8.1",
        "whitecube/nova-flexible-content": "^2.0",
        "whitecube/nova-page": "^0.4.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.5.12"
    },
    "autoload": {
        "files": [
            "app/Support/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "composer",
            "url": "https://nova.laravel.com"
        },
        {
            "type": "vcs",
            "url": "https://github.com/ayvazyan10/laravel-nova-chained-translation-manager"
        },
        {
            "type": "vcs",
            "url": "https://github.com/C0deM1ner/laravel-chunk-upload"
        },
        {
            "type": "vcs",
            "url": "https://github.com/C0deM1ner/nova-file-manager",
            "canonical": false
        }
    ]
}
